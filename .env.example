# AgentPassport — Environment Variables
# Copy this file to .env and fill in your values

# Contract address after deploying to Midnight Preview network
# Run: compact compile contracts/agentpassport.compact --output managed
# Then deploy and paste the address here
VITE_CONTRACT_ADDRESS=

# Midnight Preview Network configuration
# These are public endpoints — no secrets needed
VITE_PROOF_SERVER_URL=http://localhost:6300
VITE_INDEXER_URL=https://indexer.preview.midnight.network
VITE_NODE_URL=https://rpc.preview.midnight.network
