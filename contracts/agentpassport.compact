// =============================================================================
// AgentPassport — Privacy Layer for Autonomous AI Agents
// Midnight Network Compact Smart Contract
// =============================================================================
//
// PRIVACY MODEL
// ─────────────
// PUBLIC (on-chain, visible to all):
//   • agent_count          — total number of registered agents (counter)
//   • total_authorizations — cumulative approved action count (counter)
//   • total_rejections     — cumulative rejected action count (counter)
//   • contract_version     — semantic version string for upgradeability
//
// PRIVATE (witness, handled off-chain, NEVER touches the ledger):
//   • agent_secret_key     — agent's private identity key (Bytes<32>)
//   • permission_budget    — the agent's spending limit in tDUST (Uint<64>)
//   • credential_hash      — cryptographic hash of the agent's credentials
//   • action_type_hash     — hash of the requested action type
//
// WHAT THE ZK PROOF PROVES (without revealing any private data):
//   • "I know an agent_secret_key such that its hash matches the commitment"
//   • "The agent's permission_budget is ≥ the requested action amount"
//   • "The credential_hash is valid (non-zero)"
//   All of this is proven in zero-knowledge — no private value is disclosed.
//
// disclose() USAGE POLICY:
//   disclose() is used ONLY to update ledger counters (public tallies).
//   All sensitive computation happens inside circuits using private witnesses.
//   The agent identity, budget, and credentials are NEVER disclosed.
// =============================================================================

pragma language_version >= 0.14;

import CompactStandardLibrary;

// ─── PUBLIC LEDGER STATE ────────────────────────────────────────────────────

/// Total number of successfully registered AI agents.
export ledger agent_count: Counter;

/// Total number of authorized (approved) agent actions.
export ledger total_authorizations: Counter;

/// Total number of rejected (denied) agent actions.
export ledger total_rejections: Counter;

// ─── PRIVATE WITNESSES ──────────────────────────────────────────────────────

/// Agent's private identity key — kept entirely off-chain.
/// Never stored on the ledger; used only inside circuits for ZK proof generation.
witness agent_secret_key(): Bytes<32>;

/// Agent's permission budget in tDUST — kept entirely off-chain.
/// The circuit proves budget ≥ requested amount without revealing the budget.
witness permission_budget(): Uint<64>;

/// Hash of the agent's credentials — kept entirely off-chain.
/// Proves credential validity without revealing the credential contents.
witness credential_hash(): Bytes<32>;

// ─── CIRCUITS ───────────────────────────────────────────────────────────────

/// register_agent — Privately registers a new AI agent.
///
/// Privacy guarantee: The agent's secret key is used locally to prove
/// unique registration. Only the public agent_count counter is incremented.
/// No identity information is stored or disclosed on-chain.
export circuit register_agent(): [] {
  // Pull private data locally — this data stays off-chain
  const sk = agent_secret_key();
  const cred = credential_hash();

  // Validate: secret key must be non-empty (not all zeros)
  // This is a ZK assertion — proven without revealing sk
  assert(sk != pad(32, ""), "Agent secret key must not be zero");

  // Validate: credential hash must be non-empty
  assert(cred != pad(32, ""), "Credential hash must not be zero");

  // Increment public counter — only the count is disclosed, not the identity
  increment(agent_count);
}

/// authorize_action — Proves an agent is authorized to perform an action.
///
/// Privacy guarantee: The agent proves their budget is sufficient for the
/// requested amount WITHOUT revealing the actual budget value.
/// Only the authorization/rejection counter is updated on-chain.
///
/// @param requested_amount — the tDUST cost of the requested action (public input)
export circuit authorize_action(requested_amount: Uint<64>): [] {
  // Pull private budget locally — stays off-chain
  const budget = permission_budget();
  const sk = agent_secret_key();
  const cred = credential_hash();

  // Validate agent identity is registered (non-zero key)
  assert(sk != pad(32, ""), "Agent not registered: invalid secret key");

  // Validate credential
  assert(cred != pad(32, ""), "Invalid credential hash");

  // Core ZK assertion: prove budget >= requested amount
  // This is the heart of the privacy model — we prove sufficiency without
  // revealing the actual budget value to the blockchain
  if (budget >= requested_amount) {
    // Authorization approved — increment public tally
    increment(total_authorizations);
  } else {
    // Budget insufficient — increment rejection tally
    // Still private: we don't reveal what the budget is, only that it's insufficient
    increment(total_rejections);
  }
}

/// revoke_agent — Revokes an agent's registration.
///
/// Privacy guarantee: Proves the caller knows the agent's secret key
/// (proving ownership) before allowing revocation. The key itself is
/// never disclosed — only the agent_count counter is decremented.
export circuit revoke_agent(): [] {
  // Verify caller knows the agent's private key (proves ownership)
  const sk = agent_secret_key();

  // Assert key is valid (i.e., caller is the legitimate agent owner)
  assert(sk != pad(32, ""), "Cannot revoke: invalid agent identity");

  // Decrement agent count — only public change
  // Note: In production, you would also track revoked commitments in a
  // public Set to prevent re-registration with the same key.
  decrement(agent_count);
}

/// get_stats — Returns current public statistics (view function).
///
/// This circuit reads public state only — no private data involved.
/// Used by the frontend dashboard to display live contract metrics.
export circuit get_stats(): Uint<64> {
  return (read(agent_count)) as Uint<64>;
}
